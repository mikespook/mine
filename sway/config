# sway config file
#
# Please see sway(5) for a complete reference!

set $mod Mod4
set $hdmi HDMI-A-1
set $dp DP-1
set $maindisplay eDP-1

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:DejaVu Sans Mono 10

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod normal

# Left hand mouse
input type:pointer left_handed enabled
input type:touchpad left_handed enabled

# number lock on
input type:keyboard xkb_numlock enabled

# start a terminal
bindsym $mod+Return exec i3-sensible-terminal

# kill focused window
bindsym $mod+Shift+q kill

# start wmenu (a program launcher)
bindsym $mod+d exec wmenu-run

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

mode "Layout" {
	# change container layout (stacked, tabbed, toggle split)
	bindsym s layout stacking, mode "default"
	bindsym w layout tabbed, mode "default"
	bindsym t layout toggle split, mode "default"
	bindsym f floating toggle, mode "default"

	bindsym Return mode "default"
	bindsym Escape mode "default"
}
bindsym $mod+Shift+y mode "Layout"

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

set $ws1 "1: Apple"
set $ws2 "2: Bird"
set $ws3 "3: Cat"
set $ws4 "4: Dog"
set $ws5 "5: Egg"
set $ws6 "6: Fether"

workspace $ws1 output $dp $hdmi
workspace $ws2 output $dp $hdmi
workspace $ws3 output $dp $hdmi
workspace $ws4 output $dp $hdmi
workspace $ws5 output $dp $hdmi
workspace $ws6 output $maindisplay
# switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1, workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2, workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3, workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4, workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5, workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6, workspace $ws6

# reload the configuration file (sway has no in-place restart)
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload
# exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+e exec nautilus
# clipboard history: pick an entry to copy it back
bindsym $mod+c exec cliphist list | wmenu -l 15 -p clip | cliphist decode | wl-copy

bindsym $mod+Shift+s exec terminator -e 'sudo shutdown -h now'
# re-apply the kanshi display profile
bindsym $mod+s exec sh -c 'pkill -x kanshi; exec kanshi'

# running application with shortcut
mode "App" {
	bindsym f exec "firefox", mode "default"
	bindsym m exec "pavucontrol", mode "default"
	bindsym p exec "system-config-printer", mode "default"
	bindsym s exec "simple-scan", mode "default"
	bindsym v exec "virtualbox", mode "default"
	# back to normal: Enter or Escape
	bindsym Return mode "default"
	bindsym Escape mode "default"
}

bindsym $mod+a mode "App"

# volume mixer pops up floating, like pnmixer did
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable

# resize window (you can also use the mouse for that)
mode "resize" {
# These bindings trigger as soon as you enter the resize mode

# Pressing left will shrink the window’s width.
# Pressing right will grow the window’s width.
# Pressing up will shrink the window’s height.
# Pressing down will grow the window’s height.
	bindsym j resize shrink width 10 px or 10 ppt
	bindsym k resize grow height 10 px or 10 ppt
	bindsym l resize shrink height 10 px or 10 ppt
	bindsym semicolon resize grow width 10 px or 10 ppt

# same bindings, but for the arrow keys
	bindsym Left resize shrink width 10 px or 10 ppt
	bindsym Down resize grow height 10 px or 10 ppt
	bindsym Up resize shrink height 10 px or 10 ppt
	bindsym Right resize grow width 10 px or 10 ppt

# back to normal: Enter or Escape
	bindsym Return mode "default"
	bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# waybar instead of swaybar: swaybar can't open tray menus (no dbusmenu)
# see ~/.config/waybar/
bar {
	swaybar_command waybar
}

workspace_auto_back_and_forth yes

# Display layout (see ~/.config/kanshi/config)
# restart on every reload: sway resets unconfigured outputs on reload
exec_always sh -c 'pkill -x kanshi; exec kanshi'
exec_always ~/.mikespook/bin/wallpaper
# Network tray
exec nm-applet --indicator
# Volume tray
exec pasystray
# Clipboard history (cliphist + wl-clipboard)
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec i3-sensible-terminal
exec flameshot
exec blueman-applet
# Input method (env vars in ~/.config/environment.d/fcitx5.conf)
exec fcitx5 -d --replace

# keep the flameshot overlay floating across all outputs instead of tiled
for_window [app_id="flameshot"] border pixel 0, floating enable, fullscreen disable, move absolute position 0 0
bindsym Print exec flameshot gui
bindsym Ctrl+Print exec flameshot full

bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

include /etc/sway/config.d/*
